#
# ==========================================
# Applications
# ==========================================
#

# File manager
super + f
    thunar

# App launcher
super + r
    rofi -show drun

# Quick launch apps
super + {v,c,b,t,s}
    { code, alacritty, google-chrome-stable, Telegram, spotify-launcher }

# Prism Launcher
super + m
    prismlauncher

# Claude Desktop
super + d
    claude-desktop

# Helium Browser
super + e
    helium-browser


#
# ==========================================
# Utilities / Productivity
# ==========================================
#

# Reload sxhkd config
super + Escape
    pkill -USR1 -x sxhkd

# Toggle Polybar (kill / respawn)
super + shift + b
    ~/.config/polybar/toggle.sh


#
# ==========================================
# Media / Hardware Keys
# ==========================================
#

# Volume controls
XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- --limit 1.0

XF86AudioRaiseVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0

XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness controls
XF86MonBrightnessDown
    ~/.config/polybar/scripts/brightness.sh --dec

XF86MonBrightnessUp
    ~/.config/polybar/scripts/brightness.sh --inc

# Media playback controls
super + ctrl + space
    playerctl play-pause

super + ctrl + Left
    playerctl next

super + ctrl + Right
    playerctl previous

# Hardware media keys (if keyboard has them)
XF86Audio{Play,Pause}
    playerctl play-pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous


#
# ==========================================
# BSPWM Window Management
# ==========================================
#

# Toggle fullscreen
super + shift + f
    bspc node -t ~fullscreen

# Toggle floating mode
super + space
    bspc node -t ~floating

# Close / kill window
super + {_,shift + }q
    bspc node -{c,k}

# Focus window in direction
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Move window in direction
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Resize window
super + ctrl + {h,j,k,l}
    bspc node -z {left -20 0,down 0 20,up 0 -20,right 20 0}


#
# ==========================================
# Desktop / Workspace Controls
# ==========================================
#

# Focus or send window to desktop
super + {_,shift + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

# Increase gap
super + alt + k
    bspc config window_gap $(( $(bspc config window_gap) + 1 ))

# Decrease gap safely
super + alt + j
    bspc config window_gap $(( $(bspc config window_gap) > 0 ? $(bspc config window_gap) - 1 : 0 ))


#
# ==========================================
# Floating Window Mouse Controls
# ==========================================
#

# Move floating window with mouse
super + button2
    bspc node -v


#
# ==========================================
# Session Controls
# ==========================================
#

# Quit / restart bspwm
super + alt + {q,r}
    bspc {quit,wm -r}


